# Copy to .env and fill in. Never commit the real .env.

# Port the API listens on.
PORT=3000

# Origin allowed by CORS (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# "development" | "production". Controls whether stack traces are logged.
NODE_ENV=development

# --- Not used yet ------------------------------------------------------------
# Wired up when the Mongo layer lands. Leave empty until then.
# MONGO_URI=

# Wired up when Firebase Authentication lands. ownerId is always derived from a
# verified Firebase ID token on the server, never sent by the client.
# FIREBASE_PROJECT_ID=
